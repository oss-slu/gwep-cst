{
  "name": "gwep-cst",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-content && npm run validate-media && npm run typecheck && vite build && vite build --config vite.admin.config.ts",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "validate-content": "node scripts/validate-content.ts",
    "validate-media": "node scripts/validate-media.ts",
    "cms:generate": "node scripts/generate-cms-config.ts",
    "cms:check": "node scripts/check-cms-config.ts",
    "cms:demo-copy": "node scripts/cms-demo-copy.ts",
    "test:timezones": "node scripts/test-timezones.ts"
  },
  "dependencies": {
    "@sveltia/cms": "0.263.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
